{
  "name": "turn-0-b",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "validate": "node scripts/validate-cities.ts && node scripts/validate-observed-weather.ts",
    "check:index": "node scripts/check-index.ts",
    "check:index-dom": "node scripts/check-index-dom.ts",
    "check:wind": "node scripts/check-wind.ts",
    "check:annual": "node scripts/check-annual-contract.ts",
    "check:annual-dom": "npx tsx --tsconfig tsconfig.app.json scripts/check-annual-dom.ts",
    "check:ribbon": "npx tsx --tsconfig tsconfig.app.json scripts/check-ribbon-order.ts",
    "fetch:observed": "node scripts/fetch/build-observed-weather.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
